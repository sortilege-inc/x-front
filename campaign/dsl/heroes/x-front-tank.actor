#xfPU68h3RduZs7jw8oHnYu ^"Tank" DEF {
    EXTENDS #mmrpgCharacter0000000 ^"Character"
    PROPERTIES {
        ^"Name" STRING "Tank"
        ^"Rank" STRING "3"
        ^"Karma" STRING "3"
        ^"Health" STRING "60"
        ^"Health Damage Reduction" STRING "-1"
        ^"Focus" STRING "150"
        ^"Focus Damage Reduction" STRING "-"
        ^"Initiative Modifier" STRING "+5"
        ^"Speeds" LIST OF #mmrpgSpeed00000000000 ^"Speed" [
