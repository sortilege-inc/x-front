            DEF { ^"Name" STRING "Connections"  ^"Detail" STRING "Criminals"  ^"Printed" STRING "Connections (Criminals)" },
            DEF { ^"Name" STRING "Signature Attack"  ^"Detail" STRING "Elemental Blast"  ^"Printed" STRING "Signature Attack (Elemental Blast)" }
        ]
        ^"Tags" LIST OF #mmrpgProfileTrait0000 ^"Profile Trait" [
