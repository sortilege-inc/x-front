EXTENSION "X_Front" EXTENDS "marvelmultiverse" {
    NAME "X-FRONT: the heroes’ own powers"
    VERSION "0.1.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-28"

    # Generated by campaign/source/convert_heroes.py from the heroes’ sheets. A power here is one
    # the book prints, as the hero’s sheet words it: the book leaves the Fantastic success to "the
    # elemental type’s special effect" and tells a player to write their own element in (Elemental
    # Control); each sheet did. The Effect is the sheet’s, word for word.

    # Flare’s sheet, under “Elemental Control (Electricity/Energy)”; the book’s power is Elemental Burst
    #xfeUWkpgVIMuAOsFC0vZhI ^"Elemental Burst (Flare)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Electricity/Energy)"
            ^"Effect" STRING "The character makes a ranged attack against an enemy in line of sight. If the attack is a success, it inflicts regular damage. On a Fantastic success, the enemy takes double damage instead and is stunned for one round."
        }
    }
    # Flare’s sheet, under “Elemental Control (Electricity/Energy)”; the book’s power is Elemental Blast
    #xfqMOaQ9t27hRCFfNpla1K ^"Elemental Blast (Flare)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Electricity/Energy)"
            ^"Effect" STRING "The character makes a ranged attack with an edge at an enemy in line of sight. For this attack, add +1 to the character’s Agility damage bonus for every 2 points of Focus they spend. On a success, an affected target takes that total damage. On a Fantastic success, an affected target takes double that total damage and is stunned for one round."
        }
    }
    # Flare’s sheet, under “Elemental Control (Electricity/Energy)”; the book’s power is Elemental Barrage
    #xf4u7bmo6WHew4wu19RS8i ^"Elemental Barrage (Flare)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Electricity/Energy)"
            ^"Effect" STRING "The character designates a space within their line of sight. The attack can affect every enemy within 10 spaces of that. The character makes a single Ego check and compares it to each target’s Resilience defense. Affected enemies take half regular damage. On a Fantastic success, they take full regular damage and are stunned for one round."
        }
    }
    # Flare’s sheet, under “Elemental Control (Electricity/Energy)”; the book’s power is Elemental Push
    #xfzGBN5aJDdl8tBOPgB5j3 ^"Elemental Push (Flare)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Electricity/Energy)"
            ^"Effect" STRING "The character makes an Ego attack against the target’s Agility defense. If the attack succeeds, the character can move the target in any direction, up to 1 space times the character’s rank. On a Fantastic success, the target also takes regular damage, is knocked prone and is stunned for one round."
        }
    }
    # Flare’s sheet, under “Elemental Control”; the book’s power is Supernova
    #xfrTRjemqJOwt3r8R1au9z ^"Supernova (Flare)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control"
            ^"Effect" STRING "The character makes an Ego check and compares that against the Resilience defense of every enemy within 10 spaces. For these attacks, add +1 to the character’s Ego damage bonus for every 2 points of Focus they spend. On a success, an affected target takes half that total damage. On a Fantastic success, an affected target takes full damage and is stunned for one round."
        }
    }
    # Half-Life’s sheet, under “Elemental Control (Energy/Force)”; the book’s power is Elemental Burst
    #xf48hsdnb2E0Us5wQqJ1Zd ^"Elemental Burst (Half-Life)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Energy/Force)"
            ^"Effect" STRING "The character makes a ranged attack against an enemy in line of sight. If the attack is a success, it inflicts regular damage. On a Fantastic success, the enemy takes double damage instead and becomes Blinded for 1 round."
        }
    }
    # Half-Life’s sheet, under “Elemental Control (Energy/Force)”; the book’s power is Elemental Blast
    #xfEk5AJmsxYL1ndsVoIuVn ^"Elemental Blast (Half-Life)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control (Energy/Force)"
            ^"Effect" STRING "The character makes a ranged attack with an edge at an enemy in line of sight. For this attack, add +1 to the character’s Agility damage bonus for every 2 points of Focus they spend. On a success, an affected target takes that total damage. On a Fantastic success, an affected target takes double that total damage and has trouble on all actions for one round."
        }
    }
    # Stasis’s sheet, under “Elemental Control: Velocity”; the book’s power is Elemental Burst
    #xfwqBMA9Lz6JvuqTCcAKRc ^"Elemental Burst (Stasis)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Velocity"
            ^"Effect" STRING "The character makes a ranged attack against an enemy in line of sight. If the attack is a success, it inflicts regular damage. On a Fantastic success, the enemy takes double damage instead and is Paralyzed for one round."
        }
    }
    # Stasis’s sheet, under “Elemental Control: Velocity”; the book’s power is Elemental Grab
    #xfzUPjNaqIVDxx8Vtq7LRa ^"Elemental Grab (Stasis)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Velocity"
            ^"Effect" STRING "The character makes an Ego attack against a target’s Melee defense within 5 spaces times the character’s rank. If the attack is a success, the character grabs the target with their element. On a Fantastic success, the target can also be pinned and is Paralyzed for one round. Breaking free requires a successful Melee check against target number 20."
        }
    }
    # Tank’s sheet, under “Elemental Control: Force”; the book’s power is Elemental Burst
    #xfJHCDcFDEy6y8F7QQn2ns ^"Elemental Burst (Tank)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Force"
            ^"Effect" STRING "The character makes a ranged attack against an enemy in line of sight. If the attack is a success, it inflicts regular damage. On a Fantastic success, the enemy takes double damage instead and has trouble on all actions for one round."
        }
    }
    # Tank’s sheet, under “Elemental Control: Force”; the book’s power is Elemental Blast
    #xfz8Dj8xeAiHPXdQ4M45Xb ^"Elemental Blast (Tank)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Force"
            ^"Effect" STRING "The character makes a ranged attack with an edge at an enemy in line of sight. For this attack, add +1 to the character’s Agility damage bonus for every 2 points of Focus they spend. On a success, an affected target takes that total damage. On a Fantastic success, an affected target takes double that total damage and has trouble on all actions for one round."
        }
    }
    # Tank’s sheet, under “Elemental Control: Force”; the book’s power is Elemental Barrier
    #xfywqARYIsppEvD3RzlWee ^"Elemental Barrier (Tank)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Force"
            ^"Effect" STRING "The character forms a wall of their element within their line of sight and up to 10 spaces away per rank. This covers up to 2 spaces across (vertically/horizontally) per their rank. The character makes an Agility check and compares the results against the Agility defense of any target in the affected spaces. On a success, the character chooses which side of the barrier the target winds up on. On a failure, the target chooses. On a Fantastic success, the target has trouble on all actions for one round. Attacks against the barrier are against the character’s Ego defense. Any attacks against it that do 10 points of damage or less are instantly absorbed, and the barrier continues. If an attack does more than 10 points of damage, it destroys the barrier. Either way, the attack leaves those behind the barrier unharmed."
        }
    }
    # Tank’s sheet, under “Elemental Control: Force”; the book’s power is Elemental Sphere
    #xfuObAUDrPG8Xk0eJ89g2u ^"Elemental Sphere (Tank)" DEF {
        EXTENDS #mmrpgPower000000000000 ^"Power"
        PROPERTIES {
            ^"Power Sets" LIST OF STRING ["Elemental Control"]
            ^"Printed Power Set" STRING "Elemental Control: Force"
            ^"Effect" STRING "The character envelops themselves—and any chosen people within up to 5 spaces times their rank—in a protective sphere comprised of their element. When the sphere is formed, the character makes an Ego check and compares the results against the Agility defense of unwanted characters in the enclosed spaces. On a success, the character can move any unwanted people within the sphere’s perimeter to spaces outside of the sphere. On a Fantastic success, such moved people suffer full damage and have trouble on all actions for one round. Attacks against the sphere are against the character’s Ego defense. Any attacks against the sphere are absorbed as if made against the character’s Elemental Protection power, and the sphere continues. If an attack does more damage than the character’s Elemental Protection power can sustain, it destroys the sphere, but no one inside is harmed."
        }
    }
}
