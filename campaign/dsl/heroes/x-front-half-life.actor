            DEF { ^"Set" STRING "Elemental Control (Energy/Force)"  ^"Powers" LIST OF #mmrpgPowerEntry000000 ^"Power Entry" [DEF { ^"Name" STRING "Elemental Burst (Half-Life)"  ^"Printed" STRING "Elemental Burst (Standard, Instant, Range: 10 spaces)" }, DEF { ^"Name" STRING "Elemental Blast (Half-Life)"  ^"Printed" STRING "Elemental Blast (Standard, Instant, Cost: 5+ Focus, Range: 10 spaces)" }] },
            DEF { ^"Set" STRING "Weapons"  ^"Powers" LIST OF #mmrpgPowerEntry000000 ^"Power Entry" [DEF { ^"Name" STRING "Knife"  ^"Printed" STRING "Knife (Range: Reach, Damage Multiplier Bonus: +1) Weapons add a bonus to the user’s damage multiplier. This does not stack with any other damage multiplier bonus, so don’t add them together. Instead, use the greater of the two." }] }
        ]
    }
